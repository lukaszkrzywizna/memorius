{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Memorius",
  "version": "0.1.4",
  "identifier": "app.memorius.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: appicon: http://appicon.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI0NDEyNDI2OUVDMzlDNUIKUldSYm5NT2VKaVJCSk5XeXk0dDhHRHk1M0dYMm1veTFCakE3Zjl3OWpObTRPeEJCa3lZbFpHSmUK",
      "endpoints": [
        "https://github.com/lukaszkrzywizna/memorius/releases/latest/download/latest.json"
      ]
    }
  }
}

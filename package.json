{
  "name": "memorius",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "private": true,
  "scripts": {
    "dev": "pnpm -C apps/desktop tauri dev",
    "build": "pnpm -C apps/desktop tauri build",
    "format": "oxfmt . --write && cargo fmt --all",
    "format:check": "oxfmt . --check && cargo fmt --all --check",
    "lint": "pnpm lint:oxlint && pnpm lint:eslint",
    "lint:oxlint": "oxlint apps --max-warnings=0",
    "lint:eslint": "eslint apps --max-warnings=0",
    "lint:rust": "cargo clippy --workspace --all-targets --locked -- -D warnings",
    "typecheck": "tsc --noEmit -p apps/desktop/tsconfig.json",
    "test": "pnpm -C apps/desktop test && pnpm test:harness",
    "test:rust": "cargo test --workspace --locked && node tooling/harness/check-bindings.mjs",
    "test:harness": "vitest run --root . tooling/harness",
    "deny": "cargo deny --workspace check",
    "depcruise": "pnpm -C apps/desktop depcruise",
    "knip": "knip",
    "check:frontend:architecture": "pnpm depcruise",
    "agent:preflight": "node tooling/harness/preflight.mjs",
    "agent:preflight:fast": "node tooling/harness/preflight.mjs --fast",
    "hooks:install": "lefthook install",
    "install:mac": "sh tooling/install-mac.sh"
  },
  "devDependencies": {
    "@eslint/js": "catalog:",
    "@tanstack/eslint-plugin-query": "catalog:",
    "@types/node": "catalog:",
    "@typescript/native": "catalog:",
    "@vitest/eslint-plugin": "catalog:",
    "eslint": "catalog:",
    "eslint-import-resolver-typescript": "catalog:",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-jsx-a11y": "catalog:",
    "eslint-plugin-oxlint": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-storybook": "catalog:",
    "eslint-plugin-testing-library": "catalog:",
    "globals": "catalog:",
    "knip": "catalog:",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "typescript-eslint": "catalog:",
    "vitest": "catalog:"
  }
}
